{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "*": ["./src/*"]
    },
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2022",
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "types": [
      "svelte",
      "node",
      "moment"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.svelte"
  ]
}
